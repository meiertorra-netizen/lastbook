<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions the app needs (packaging/sign_macos.sh): Python's ctypes and PyObjC make small
     callback trampolines in memory at run time (libffi closures). Nothing else: no network server, no camera, no files
     outside what the person opens or the folders the app's Info.plist names. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
